{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    { "name": "windows-release", "displayName": "Windows MSVC Release", "inherits": "windows-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "windows-debug", "displayName": "Windows MSVC Debug", "inherits": "windows-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    {
      "name": "unix-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "unix-release", "displayName": "Linux / macOS Release", "inherits": "unix-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "unix-debug", "displayName": "Linux / macOS Debug", "inherits": "unix-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "unix-release", "configurePreset": "unix-release" },
    { "name": "unix-debug", "configurePreset": "unix-debug" }
  ]
}
