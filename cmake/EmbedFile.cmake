# Writes a file's bytes as a C++ array, to be compiled into the library (the default font...).
#   cmake -DINPUT=<file> -DOUTPUT=<.cpp> -DNAMESPACE=<ns> -DNAME=<identifier> -P EmbedFile.cmake
# The source defines   extern const unsigned char NAME[];   extern const std::size_t NAMESize;   in NAMESPACE.
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR size "${length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# lines of 32 bytes, so that compilers and editors do not meet one line of hundreds of kilobytes
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n    " bytes "${bytes}")
file(WRITE "${OUTPUT}" "// Generated by cmake/EmbedFile.cmake from ${INPUT}: do not edit.
#include <cstddef>

namespace ${NAMESPACE} {

extern const unsigned char ${NAME}[] = {
    ${bytes}
};
extern const std::size_t ${NAME}Size = ${size};

} // namespace ${NAMESPACE}
")
